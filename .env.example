PORT=3000
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated list of allowed origins, or leave empty if frontend is served by this server
CORS_ORIGIN=
DB_PATH=./data/nightguard.db
# Public base URL used when building share links
PUBLIC_URL=http://localhost:3000

# Optional: real SMS on SOS (Twilio). Leave blank to only log SOS events.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
